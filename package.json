{
  "name": "@kxh4892636/dsh-toolkit",
  "version": "0.5.86",
  "description": "DSH plugin: a toolkit of independently switchable tools — nested skill discovery, office skill masking, plus the Nano Flow agent preset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kxh4892636/dsh-toolkit.git"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-nano-flow-assets.mjs && node scripts/wrap-client.mjs",
    "check": "vp check",
    "test": "vp test src",
    "test:coverage": "vp test --run --coverage",
    "prepack": "vp run --no-cache build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "^20.11.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.3",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
